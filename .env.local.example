# === CMDLY configuration ===
# Copie ce fichier en .env.local et renseigne les valeurs.

# Mode de données : demo (simulé, défaut) | live (vrais endpoints, sur le bastion)
CMDLY_MODE=demo

# Racine du projet PRA sur le bastion (utilisé par le mode live, jalons ultérieurs)
PRA_PROJECT_DIR=/opt/pra-project

# --- Proxmox (mode live) ---
PVE_HOST=192.168.1.200
PVE_PORT=8006
PVE_TOKEN_ID=terraform@pve!tf
PVE_TOKEN_SECRET=            # secret du token — JAMAIS exposé au client
PVE_VERIFY_TLS=false

# --- Prometheus / Alertmanager (mode live) ---
PROM_URL=http://10.10.20.31:9090
ALERTMANAGER_URL=http://10.10.20.31:9093

# --- Persistance (SQLite) ---
CMDLY_DB_PATH=./cmdly.db

# --- Authentification (better-auth) ---
BETTER_AUTH_SECRET=          # openssl rand -hex 32
BETTER_AUTH_URL=http://127.0.0.1:8700

# --- Compte admin initial (utilisé par `pnpm seed`) ---
CMDLY_ADMIN_EMAIL=admin@pra.local
CMDLY_ADMIN_PASSWORD=        # choisis un mot de passe fort

# --- Écoute réseau (rappel : 127.0.0.1 uniquement) ---
BIND_HOST=127.0.0.1
BIND_PORT=8700
